# Minimal local stub for the libsql extension module (it ships no type information).
# Only the part of the DB-API surface this project uses.
from collections.abc import Iterable, Sequence
from typing import Any

class Error(Exception): ...

class Cursor:
    def fetchall(self) -> list[tuple[Any, ...]]: ...
    def fetchone(self) -> tuple[Any, ...] | None: ...

class Connection:
    def execute(self, sql: str, parameters: Sequence[Any] = ..., /) -> Cursor: ...
    def executemany(self, sql: str, parameters: Iterable[Sequence[Any]], /) -> Cursor: ...
    def commit(self) -> None: ...
    def close(self) -> None: ...

def connect(database: str, *args: Any, **kwargs: Any) -> Connection: ...
